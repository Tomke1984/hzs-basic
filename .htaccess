# HZS-website: alle verzoeken via index.php, behalve bestaande bestanden (assets, uploads)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Afgeschermde mappen
  RewriteRule ^(app|data|seed|tests)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|router\.php|README\.md|CHANGELOG\.md|\.gitignore|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

